# api
REST_NODE_ENV=development
REST_PORT=3000

# db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# front-end
FRONTEND_URL=http://localhost:5173

# github oauth
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback
SESSION_SECRET=replace-with-a-long-random-string

# payments
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# platform's minimum cut of any payment, integer cents (optional, defaults to 99)
PLATFORM_MIN_CENTS=99
# publishable key - safe to expose in client JS; also set in vue/.env.*
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# actions
SCHEDULER_API_KEY=replace-with-a-long-random-string

# build

[Unit]
Description=commitment_ API (Docker container)
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
# Belt-and-suspenders: clear out any stale container from a previous crashed
# run before starting a fresh one (the "-" prefix means "ignore failure" --
# there may not be one to remove).
ExecStartPre=-/usr/bin/docker rm -f commitment-api
ExecStart=/usr/bin/docker run --rm --name commitment-api --env-file /home/ec2-user/commitment-api/.env -p 3000:3000 __ECR_IMAGE__:latest
ExecStop=/usr/bin/docker stop commitment-api
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
